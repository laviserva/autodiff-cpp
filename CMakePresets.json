{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "description": "Comun a todos. Sin generador fijo: CMake usa Visual Studio en Windows y Makefiles en Linux.",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_CXX_STANDARD": "20",
        "CMAKE_CXX_STANDARD_REQUIRED": "ON",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "debug",
      "displayName": "Debug",
      "inherits": "base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    },
    {
      "name": "release",
      "displayName": "Release",
      "inherits": "base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    },
    {
      "name": "relwithdebinfo",
      "displayName": "RelWithDebInfo",
      "description": "Optimizado pero con simbolos: es la configuracion del perfilado de la semana 7.",
      "inherits": "base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "RelWithDebInfo" }
    },
    {
      "name": "asan",
      "displayName": "AddressSanitizer + UBSan (solo Linux)",
      "description": "Detecta accesos fuera de rango y comportamiento indefinido. MSVC no soporta UBSan, por eso solo Linux.",
      "inherits": "base",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_CXX_FLAGS": "-fsanitize=address,undefined -fno-omit-frame-pointer -g"
      }
    }
  ],
  "buildPresets": [
    { "name": "debug",          "configurePreset": "debug",          "configuration": "Debug" },
    { "name": "release",        "configurePreset": "release",        "configuration": "Release" },
    { "name": "relwithdebinfo", "configurePreset": "relwithdebinfo", "configuration": "RelWithDebInfo" },
    { "name": "asan",           "configurePreset": "asan",           "configuration": "RelWithDebInfo" }
  ],
  "testPresets": [
    { "name": "debug",          "configurePreset": "debug",          "configuration": "Debug",          "output": { "outputOnFailure": true } },
    { "name": "release",        "configurePreset": "release",        "configuration": "Release",        "output": { "outputOnFailure": true } },
    { "name": "relwithdebinfo", "configurePreset": "relwithdebinfo", "configuration": "RelWithDebInfo", "output": { "outputOnFailure": true } },
    { "name": "asan",           "configurePreset": "asan",           "configuration": "RelWithDebInfo", "output": { "outputOnFailure": true } }
  ]
}
